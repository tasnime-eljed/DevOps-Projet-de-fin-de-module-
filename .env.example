# =====================================================================
#  Modèle de configuration — DevOps-Projet-de-fin-de-module
# =====================================================================
#  1. Copier ce fichier :   Copy-Item .env.example .env
#  2. Remplacer chaque valeur "change_me..." dans .env
#  3. Ne JAMAIS committer le fichier .env (il est ignoré par Git)
#
#  Format : CLE=valeur  (pas d'espaces autour du "=", pas de guillemets)
#  Ce fichier est lu par Docker Compose ET par Spring Boot en local.
# =====================================================================

# --- MySQL (utilisé par Docker Compose) ---
# Mot de passe du super-utilisateur root du conteneur MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
# Compte applicatif utilisé par le backend et users-microservice
MYSQL_APP_USER=app_user
MYSQL_APP_PASSWORD=change_me_app_password

# --- JWT ---
# Clé secrète partagée par le backend et users-microservice.
# Utiliser une longue valeur aléatoire (au moins 32 caractères), par exemple générée avec :
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
JWT_SECRET=change_me_long_random_secret_at_least_32_chars

# --- Gmail (envoi du code de vérification à l'inscription) ---
# MAIL_PASSWORD doit être un "mot de passe d'application" Gmail (pas le mot de passe du compte).
MAIL_USERNAME=your_address@gmail.com
MAIL_PASSWORD=change_me_gmail_app_password

# --- Compte administrateur initial (créé seulement s'il n'existe pas) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# --- Port du frontend sur ce PC (http://localhost:<port>) ---
# 8080 n'est pas utilise par ce projet.
FRONTEND_PORT=8088
